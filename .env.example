# GEMINI_API_KEY: Optional server-side Gemini API key (used when AI agent is set to Gemini AI).
# Set this in Render Environment Variables or AI Studio Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this app is hosted (e.g. https://journal-paper-dashboard.onrender.com).
# Used by the extension ZIP builder and proxy-aware URLs.
APP_URL="MY_APP_URL"

# Optional client-side Firebase config for Gmail OAuth alerts (public browser config; set in Render Env Vars if using a custom Firebase project)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional Local Ollama server configuration
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"
